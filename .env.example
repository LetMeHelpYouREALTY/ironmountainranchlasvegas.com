# OpenRouter API Configuration
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Next.js Environment
NODE_ENV=development

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://heyberkshire.com

# -----------------------------------------------------------------------------
# Cloudflare Images (optional — site can stay on Vercel with DNS-only / gray cloud)
# Docs: https://developers.cloudflare.com/images/
# -----------------------------------------------------------------------------
# Use zone URL interface: /cdn-cgi/image/width=…,format=auto/<path>
# NEXT_PUBLIC_CF_IMAGE_RESIZING=true
# Dedicated image host when apex is gray-clouded in front of Vercel (orange-cloud this host only):
# NEXT_PUBLIC_CF_IMAGE_ZONE=https://img.heyberkshire.com
#
# Or route image paths through the Worker query-string optimizer (workers/image-optimizer.ts):
# NEXT_PUBLIC_CF_IMAGE_WORKER=true
#
# Or Cloudflare Hosted Images (imagedelivery.net):
# NEXT_PUBLIC_CLOUDFLARE_IMAGES_ENABLED=true
# NEXT_PUBLIC_CLOUDFLARE_ACCOUNT_HASH=your_account_hash
