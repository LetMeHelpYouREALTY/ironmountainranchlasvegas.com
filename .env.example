# OpenRouter API Configuration
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Next.js Environment
NODE_ENV=development

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://heyberkshire.com

# Google Maps Platform (amenity map — Maps JavaScript API + Places API New)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional: Map ID for Advanced Markers styling
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# -----------------------------------------------------------------------------
# Cloudflare Images — current practice (Aug 2026)
# Docs:
#   https://developers.cloudflare.com/images/optimization/transformations/integrate-with-frameworks/
#   https://developers.cloudflare.com/images/optimization/transformations/flows/
# -----------------------------------------------------------------------------
#
# Recommended order for this Vercel + DNS-only (gray cloud) setup:
#
# A) Dashboard Transformation Flows (zero code) on an orange-cloud image host
#    Images → Transformations → Automation → Custom flow
#    Conditions: path /images/* (and /Image/* if needed)
#    Actions: format=auto, quality=medium-high or 75, optional width=auto
#
# B) Next.js official custom loader → /cdn-cgi/image/width=…,quality=…,format=auto/…
# NEXT_PUBLIC_CF_IMAGE_RESIZING=true
# NEXT_PUBLIC_CF_IMAGE_ZONE=https://img.heyberkshire.com
#
# C) Hosted Images (imagedelivery.net) — only if assets are uploaded to CF Images
# NEXT_PUBLIC_CLOUDFLARE_IMAGES_ENABLED=true
# NEXT_PUBLIC_CLOUDFLARE_ACCOUNT_HASH=your_account_hash
#
# Do NOT orange-cloud the Vercel apex (SSL conflicts). Orange-cloud the image
# host only. Images binding / Workers byte pipelines are paid — leave off unless needed.
